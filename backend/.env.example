# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (include the NEW password after rotating it)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Long random string used to sign login tokens
ACCESS_TOKEN_SECRET=

# Gmail account + app password used to send task reminders
EMAIL_USER=
EMAIL_PASS=

# Google Gemini key for the screener's "give me an example" help
GEMINI_API_KEY=

# Comma-separated frontend URLs allowed to call the API (leave empty to allow all)
CLIENT_ORIGIN=http://localhost:5173

# Time zone used in reminder emails
TIMEZONE=America/Chicago

PORT=8000
